---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Trilha from '../components/Trilha.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import { INSTITUCIONAL, CONTATO } from '../config/site';
import { fabricantePorSlug } from '../data/fabricantes';
import { categorias } from '../data/categorias';
import { rotas } from '../lib/utils';

// Dados institucionais aparecem somente quando preenchidos em src/config/site.ts.
const fatos = [
  INSTITUCIONAL.anoFundacao && { rotulo: 'Fundação', valor: String(INSTITUCIONAL.anoFundacao) },
  INSTITUCIONAL.cidade && { rotulo: 'Sede', valor: INSTITUCIONAL.cidade },
  CONTATO.cnpj && { rotulo: 'CNPJ', valor: CONTATO.cnpj },
].filter(Boolean) as { rotulo: string; valor: string }[];
const parcerias = INSTITUCIONAL.parceriasConfirmadas.map((s) => fabricantePorSlug(s)).filter(Boolean);

const etapas = [
  { titulo: 'Entendimento', texto: 'Conversa sobre o ambiente atual, os dados tratados, as ferramentas existentes e as exigências de clientes ou normas.' },
  { titulo: 'Recomendação', texto: 'Indicação das soluções do portfólio que atendem às prioridades identificadas, com o que cada uma cobre e o que não cobre.' },
  { titulo: 'Validação', texto: 'Avaliação, demonstração ou teste conforme a solução, para confirmar compatibilidade e aderência antes da contratação.' },
  { titulo: 'Proposta', texto: 'Proposta comercial com o licenciamento adequado ao porte e ao modelo de uso.' },
];
---

<Base titulo="Sobre a ARXEN" descricao="A ARXEN Security apresenta soluções de cibersegurança organizadas por necessidade, com recomendações proporcionais ao risco e ao contexto de cada empresa." secaoAtiva="sobre">
  <section class="sobre-hero">
    <div class="wrap">
      <Trilha itens={[{ rotulo: 'Sobre' }]} />
      <div class="sobre-hero__grade">
        <div>
          <h1>Sobre a ARXEN Security</h1>
        </div>
        <div class="sobre-hero__texto">
          <p class="lead">
            A ARXEN Security reúne soluções de cibersegurança de fabricantes especializados e ajuda empresas a escolher, entre elas, as que fazem sentido para o próprio ambiente.
          </p>
          <p class="texto-2">
            Para recomendar bem, é preciso entender o que precisa ser protegido. Por isso o portfólio é organizado por necessidade (dados, dispositivos, e-mail, acessos, backup, vulnerabilidades e detecção) e cada indicação parte do ambiente do cliente.
          </p>
        </div>
      </div>
      {
        fatos.length > 0 && (
          <dl class="fatos">
            {fatos.map((f) => (
              <div>
                <dt>{f.rotulo}</dt>
                <dd>{f.valor}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <section class="secao s-escura" aria-labelledby="t-abord">
    <div class="wrap">
      <div class="cabeca cabeca--split">
        <div>
          <h2 id="t-abord">Como funciona o atendimento</h2>
        </div>
        <p class="lead">As etapas evitam contratar algo que não resolve o problema ou que repete uma função que a empresa já tem.</p>
      </div>
      <ol class="abord">
        {
          etapas.map((e, i) => (
            <li class="revelar" style={`--atraso:${i * 90}ms`}>
              <h3>{e.titulo}</h3>
              <p class="texto-2">{e.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="secao--compacta" aria-labelledby="t-comp">
    <div class="wrap comp">
      <div>
        <h2 id="t-comp">O que você pode esperar</h2>
      </div>
      <ul class="comp__lista">
        <li>
          <h3>Informação verificável</h3>
          <p class="texto-2">Descrições baseadas em fontes oficiais dos fabricantes, com links para conferência em cada página de solução.</p>
        </li>
        <li>
          <h3>Sem promessas absolutas</h3>
          <p class="texto-2">Nenhuma solução elimina todo risco. O objetivo é reduzir a exposição de forma proporcional e mensurável.</p>
        </li>
        <li>
          <h3>Recomendação proporcional</h3>
          <p class="texto-2">O porte, o setor e a maturidade da empresa definem o que vem primeiro.</p>
        </li>
        <li>
          <h3>Privacidade dos dados</h3>
          <p class="texto-2">As informações compartilhadas no contato são usadas apenas para responder à solicitação.</p>
        </li>
      </ul>
    </div>
  </section>

  {
    (INSTITUCIONAL.certificacoes.length > 0 || parcerias.length > 0) && (
      <section class="secao--compacta s-papel" aria-labelledby="t-cred">
        <div class="wrap">
          <h2 id="t-cred">Credenciais</h2>
          <ul class="cred">
            {INSTITUCIONAL.certificacoes.map((c) => (
              <li>
                <strong>{c.titulo}</strong>
                {c.descricao && <p class="texto-2">{c.descricao}</p>}
              </li>
            ))}
            {parcerias.map((f) => (
              <li>
                <strong>Parceria {f!.nome}</strong>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="secao--compacta s-papel" aria-labelledby="t-areas">
    <div class="wrap">
      <h2 id="t-areas" class="areas__titulo">Áreas de atuação</h2>
      <ul class="areas">
        {categorias.map((c) => <li><a href={rotas.categoria(c.slug)}><Icon nome={c.icone} tamanho={20} /><span>{c.nome}</span></a></li>)}
      </ul>
    </div>
  </section>

  <ChamadaFinal />
</Base>

<style>
  .sobre-hero {
    padding-block: 28px clamp(56px, 8vw, 104px);
  }
  .sobre-hero__grade {
    display: grid;
    gap: 32px;
    margin-top: clamp(28px, 5vw, 64px);
  }
  .sobre-hero h1 {
    max-width: 12ch;
  }
  .sobre-hero__texto {
    display: grid;
    gap: 18px;
    align-content: end;
  }
  @media (min-width: 980px) {
    .sobre-hero__grade {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }
  .fatos {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin: 48px 0 0;
    padding-top: 28px;
    border-top: 1px solid var(--line-l);
  }
  .fatos dt {
    font-size: 0.82rem;
    color: var(--tx-l-2);
  }
  .fatos dd {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
  }
  .abord {
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--line-d);
    border: 1px solid var(--line-d);
    border-radius: var(--r-3);
    overflow: hidden;
  }
  @media (min-width: 700px) {
    .abord {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .abord {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .abord li {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 28px;
    background: var(--ink-0);
  }
  .abord__n {
    font-size: 0.78rem;
    color: var(--blue);
    margin-bottom: 18px;
  }
  .abord p {
    font-size: 0.94rem;
  }
  .comp {
    display: grid;
    gap: 36px;
  }
  .comp__lista {
    list-style: none;
    display: grid;
    gap: 28px 48px;
  }
  @media (min-width: 700px) {
    .comp__lista {
      grid-template-columns: 1fr 1fr;
    }
  }
  .comp__lista li {
    display: grid;
    gap: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--line-l-2);
  }
  @media (min-width: 980px) {
    .comp {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 80px;
    }
  }
  .cred {
    list-style: none;
    display: grid;
    gap: 16px;
    margin-top: 20px;
  }
  .areas__titulo {
    font-size: 1.3rem;
    margin-bottom: 18px;
  }
  .areas {
    list-style: none;
    display: grid;
    gap: 0 40px;
  }
  @media (min-width: 700px) {
    .areas {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .areas a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    border-bottom: 1px solid var(--line-l-2);
    text-decoration: none;
    font-weight: 500;
  }
  .areas a :global(.icone) {
    color: var(--blue);
    flex: none;
  }
  .areas a:hover {
    color: var(--blue-ink);
  }
</style>
