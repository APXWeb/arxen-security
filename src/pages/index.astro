---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CardSolucao from '../components/CardSolucao.astro';
import LogoFabricante from '../components/LogoFabricante.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import { categorias } from '../data/categorias';
import { fabricantes } from '../data/fabricantes';
import { solucoes, solucoesDaCategoria, solucoesDoFabricante } from '../data/solucoes';
import { SITE } from '../config/site';
import { rotas, url } from '../lib/utils';

const destaques = solucoes.filter((s) => s.destaque).slice(0, 6);

// Sugestões de busca que levam direto a resultados do catálogo.
const atalhos = ['Ransomware', 'DMARC', 'Backup Microsoft 365', 'LGPD', 'Acesso privilegiado', 'XDR'];

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.nome,
  url: new URL(rotas.inicio(), Astro.site).href,
  logo: new URL(url('img/brand/arxen-logo.png'), Astro.site).href,
  description: SITE.descricaoPadrao,
};
---

<Base
  titulo="ARXEN Security — Segurança digital para proteger o que move sua empresa"
  tituloCompleto
  descricao="Catálogo de soluções de cibersegurança para empresas e revendas: proteção de endpoints, DLP, e-mail, backup, gestão de acessos, vulnerabilidades e detecção de ameaças."
  jsonLd={ld}
>
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="wrap">
      <div class="hero__grade">
        <div class="hero__texto">
          <h1 id="hero-titulo" class="revelar">Segurança digital para proteger o que move sua empresa.</h1>
          <p class="lead revelar" style="--atraso:80ms">
            Proteção para dados, dispositivos, e-mails e acessos, com soluções de fabricantes especializados e uma recomendação feita a partir do ambiente de cada empresa.
          </p>
          <div class="acoes revelar" style="--atraso:140ms">
            <a class="btn btn--primario" href={rotas.solucoes()}>Conhecer soluções <Icon nome="seta" /></a>
            <a class="btn btn--contorno" href={rotas.contato()}>Falar com um especialista</a>
          </div>
        </div>

        <form class="procura revelar" style="--atraso:200ms" action={rotas.solucoes()} method="get" role="search">
          <label class="procura__titulo" for="procura-q">Já sabe o que procura?</label>
          <div class="procura__campo">
            <Icon nome="busca" tamanho={20} />
            <input id="procura-q" name="q" type="search" placeholder="Produto, fabricante ou assunto" autocomplete="off" enterkeyhint="search" />
            <button class="btn btn--escuro btn--pequeno" type="submit">Buscar</button>
          </div>
          <p class="procura__sub">Sugestões</p>
          <ul class="procura__atalhos">
            {atalhos.map((a) => <li><a href={`${rotas.solucoes()}?q=${encodeURIComponent(a)}`}>{a}</a></li>)}
          </ul>
        </form>
      </div>

      <ul class="hero__logos" aria-label="Fabricantes do catálogo">
        {
          fabricantes.map((f) => (
            <li>
              <a href={rotas.fabricante(f.slug)} title={f.nome}>
                <LogoFabricante fabricante={f} area={1500} larguraMax={118} carregamento="eager" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao nec-secao" aria-labelledby="nec-titulo">
    <div class="wrap">
      <div class="cabeca cabeca--split">
        <h2 id="nec-titulo" class="revelar">Soluções por necessidade</h2>
        <p class="lead revelar" style="--atraso:80ms">
          Cada área reúne produtos de fabricantes diferentes. Assim dá para comparar abordagens e montar a proteção em camadas, sem pagar duas vezes pela mesma função.
        </p>
      </div>

      <ul class="necessidades">
        {
          categorias.map((c, i) => {
            const n = solucoesDaCategoria(c.slug).length;
            return (
              <li class="revelar" style={`--atraso:${(i % 2) * 60}ms`}>
                <a class="nec" href={rotas.categoria(c.slug)}>
                  <span class="nec__icone">
                    <Icon nome={c.icone} tamanho={22} />
                  </span>
                  <span class="nec__corpo">
                    <span class="nec__nome">{c.nome}</span>
                    <span class="nec__resumo">{c.resumo}</span>
                  </span>
                  <span class="nec__qtd">
                    {n} {n === 1 ? 'solução' : 'soluções'}
                    <Icon nome="seta" tamanho={16} />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="secao fabs" aria-labelledby="fab-titulo">
    <div class="wrap">
      <div class="cabeca cabeca--split">
        <h2 id="fab-titulo" class="revelar">Fabricantes do catálogo</h2>
        <p class="lead revelar" style="--atraso:80ms">
          Nove fabricantes, cada um especializado em uma parte da segurança. Em cada página estão os produtos, os cenários indicados e as diferenças entre as opções.
        </p>
      </div>

      <ul class="fabs__lista">
        {
          fabricantes.map((f) => {
            const n = solucoesDoFabricante(f.slug).length;
            return (
              <li class="revelar">
                <a class="fab-linha" href={rotas.fabricante(f.slug)}>
                  <span class="fab-linha__logo">
                    <LogoFabricante fabricante={f} area={2600} larguraMax={150} />
                  </span>
                  <span class="fab-linha__nome">{f.nome}</span>
                  <span class="fab-linha__foco">{f.foco}</span>
                  <span class="fab-linha__qtd">
                    {n} {n === 1 ? 'solução' : 'soluções'}
                    <Icon nome="seta" tamanho={16} />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
      <p class="fabs__nota">A apresentação dos fabricantes não indica parceria oficial, distribuição autorizada ou certificação junto a eles.</p>
    </div>
  </section>

  <section class="secao s-papel" aria-labelledby="dest-titulo">
    <div class="wrap">
      <div class="dest__cabeca">
        <h2 id="dest-titulo" class="revelar">Em destaque</h2>
        <a class="link-seta revelar" href={rotas.solucoes()}><span>Ver as {solucoes.length} soluções</span><Icon nome="seta" /></a>
      </div>
      <div class="dest__grade">
        {
          destaques.map((s, i) => (
            <div class="revelar" style={`--atraso:${(i % 3) * 70}ms`}>
              <CardSolucao solucao={s} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="secao publicos" aria-labelledby="pub-titulo">
    <div class="wrap">
      <h2 id="pub-titulo" class="publicos__titulo revelar">Para empresas e para revendas</h2>
      <div class="publicos__grade">
        <article class="publico revelar">
          <h3>Sua empresa precisa de proteção</h3>
          <p class="texto-2">
            Conte como é o ambiente hoje: quantas máquinas, onde ficam os dados, que ferramentas já existem. A partir disso a ARXEN indica o que faz sentido e o próximo passo, seja avaliação, demonstração ou proposta.
          </p>
          <a class="link-seta" href={rotas.contato({ perfil: 'empresa' })}><span>Encontrar a solução certa</span><Icon nome="seta" /></a>
        </article>
        <article class="publico publico--revenda revelar" style="--atraso:100ms">
          <h3>Você atende clientes de TI</h3>
          <p class="texto-2">
            Revendas, MSPs e integradores podem conversar com a ARXEN sobre o portfólio, as formas de licenciamento e oportunidades que já estão em andamento.
          </p>
          <a class="link-seta" href={rotas.revendas()}><span>Conversar sobre parceria comercial</span><Icon nome="seta" /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="secao s-papel inst" aria-labelledby="inst-titulo">
    <div class="wrap inst__grade">
      <div class="inst__texto">
        <h2 id="inst-titulo" class="revelar">Recomendação de acordo com o risco de cada empresa.</h2>
        <p class="lead revelar" style="--atraso:80ms">
          Um escritório de contabilidade, uma indústria e um provedor de TI têm dados, rotinas e exposições diferentes. A indicação de soluções parte dessas diferenças.
        </p>
        <a class="link-seta revelar" href={rotas.sobre()}><span>Sobre a ARXEN</span><Icon nome="seta" /></a>
      </div>
      <dl class="principios">
        <div class="revelar">
          <dt>Entendimento do ambiente</dt>
          <dd>O ponto de partida é o que já existe, o que preocupa e o que precisa ser comprovado para clientes ou auditorias.</dd>
        </div>
        <div class="revelar" style="--atraso:80ms">
          <dt>Camadas que se complementam</dt>
          <dd>Cada produto cobre uma superfície. Combinar sem sobreposição reduz custo e complexidade.</dd>
        </div>
        <div class="revelar" style="--atraso:160ms">
          <dt>Informação clara sobre cada produto</dt>
          <dd>O que a solução faz, o que ela não cobre e o que depende do seu ambiente, explicado antes da proposta.</dd>
        </div>
      </dl>
    </div>
  </section>

  <ChamadaFinal />
</Base>

<style>
  /* Abertura */
  .hero {
    padding-block: clamp(64px, 9vw, 120px) 0;
    border-bottom: 1px solid var(--line-l);
  }
  .hero__grade {
    display: grid;
    gap: 48px;
    align-items: end;
  }
  .hero__grade > * {
    min-width: 0;
  }
  .hero__texto {
    display: grid;
    gap: 26px;
    justify-items: start;
    align-content: start;
  }
  .hero h1 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5.6vw, 4.6rem);
  }
  @media (min-width: 1000px) {
    .hero__grade {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
      gap: 72px;
    }
  }

  .procura {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    padding: clamp(18px, 4vw, 26px);
    border: 1px solid var(--line-l-2);
    border-radius: var(--r-3);
    background: var(--white);
  }
  .procura__titulo {
    font-weight: 600;
    font-size: 1.05rem;
  }
  .procura__campo {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 46px;
    border: 1px solid var(--line-l-2);
    border-radius: var(--r-2);
    background: var(--page);
    transition: border-color var(--t-1), box-shadow var(--t-1);
  }
  .procura__campo:focus-within {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(77, 132, 255, 0.25);
  }
  .procura__campo :global(.icone) {
    position: absolute;
    left: 16px;
    color: var(--tx-l-2);
  }
  .procura__campo input {
    flex: 1;
    min-width: 0;
    height: 44px;
    border: 0;
    background: transparent;
    font-size: 1rem;
  }
  .procura__campo input:focus {
    outline: none;
  }
  .procura__campo input::placeholder {
    color: var(--tx-d-3);
  }
  .procura__sub {
    margin-top: 6px;
    font-size: 0.85rem;
    color: var(--tx-l-2);
  }
  .procura__atalhos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .procura__atalhos a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line-l-2);
    border-radius: 99px;
    font-size: 0.88rem;
    text-decoration: none;
    color: var(--tx-l-1);
    transition: border-color var(--t-1), background var(--t-1);
  }
  .procura__atalhos a:hover {
    border-color: var(--blue);
    background: rgba(77, 132, 255, 0.08);
  }

  .hero__logos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(56px, 7vw, 96px);
    border-top: 1px solid var(--line-l);
  }
  .hero__logos a {
    display: grid;
    place-items: center;
    height: 92px;
    opacity: 0.72;
    transition: opacity var(--t-2);
  }
  .hero__logos a:hover {
    opacity: 1;
  }
  @media (min-width: 760px) {
    .hero__logos {
      grid-template-columns: repeat(9, 1fr);
    }
    .hero__logos a {
      height: 108px;
    }
  }

  /* Necessidades */
  .necessidades {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--line-l);
  }
  @media (min-width: 900px) {
    .necessidades {
      grid-template-columns: 1fr 1fr;
      column-gap: 56px;
    }
  }
  .nec {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 4px 18px;
    align-items: start;
    padding: 26px 0;
    border-bottom: 1px solid var(--line-l);
    text-decoration: none;
    height: 100%;
  }
  .nec__icone {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-2);
    border: 1px solid var(--line-l-2);
    color: var(--blue);
    transition: background var(--t-2), border-color var(--t-2);
  }
  .nec:hover .nec__icone {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .nec__corpo {
    display: grid;
    gap: 6px;
  }
  .nec__nome {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.3;
  }
  .nec:hover .nec__nome {
    color: var(--blue-ink);
  }
  .nec__resumo {
    color: var(--tx-l-2);
    font-size: 0.94rem;
    line-height: 1.5;
  }
  .nec__qtd {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--tx-l-2);
  }
  .nec__qtd :global(.icone) {
    transition: transform var(--t-2) var(--ease);
  }
  .nec:hover .nec__qtd :global(.icone) {
    transform: translateX(4px);
  }

  /* Fabricantes em linhas */
  .fabs {
    border-top: 1px solid var(--line-l);
  }
  .fabs__lista {
    list-style: none;
    border-top: 1px solid var(--line-l);
  }
  .fab-linha {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 6px 24px;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid var(--line-l);
    text-decoration: none;
    transition: background var(--t-2);
  }
  .fab-linha__logo {
    grid-row: span 2;
    display: flex;
    align-items: center;
    height: 48px;
  }
  .fab-linha__nome {
    font-weight: 600;
  }
  .fab-linha__foco {
    color: var(--tx-l-2);
    font-size: 0.93rem;
  }
  .fab-linha__qtd {
    display: none;
  }
  .fab-linha:hover .fab-linha__nome {
    color: var(--blue-ink);
  }
  @media (min-width: 860px) {
    .fab-linha {
      grid-template-columns: 200px 220px 1fr auto;
      padding: 26px 16px;
      margin-inline: -16px;
      border-radius: var(--r-1);
    }
    .fab-linha:hover {
      background: var(--white);
    }
    .fab-linha__logo {
      grid-row: auto;
    }
    .fab-linha__qtd {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      color: var(--tx-l-2);
    }
    .fab-linha__qtd :global(.icone) {
      transition: transform var(--t-2) var(--ease);
    }
    .fab-linha:hover .fab-linha__qtd :global(.icone) {
      transform: translateX(4px);
      color: var(--blue-ink);
    }
  }
  .fabs__nota {
    margin-top: 20px;
    font-size: 0.82rem;
    color: var(--tx-d-3);
  }

  /* Destaques */
  .dest__cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .dest__grade {
    display: grid;
    gap: 16px;
  }
  .dest__grade > div {
    display: grid;
  }
  @media (min-width: 700px) {
    .dest__grade {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1060px) {
    .dest__grade {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Públicos */
  .publicos__titulo {
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .publicos__grade {
    display: grid;
    border-top: 1px solid var(--line-l-2);
  }
  @media (min-width: 900px) {
    .publicos__grade {
      grid-template-columns: 1fr 1fr;
    }
    .publico--revenda {
      border-left: 1px solid var(--line-l-2);
      padding-left: 56px;
    }
    .publico:first-child {
      padding-right: 56px;
    }
  }
  .publico {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 36px;
    align-items: flex-start;
  }
  .publico + .publico {
    border-top: 1px solid var(--line-l-2);
  }
  @media (min-width: 900px) {
    .publico + .publico {
      border-top: 0;
    }
  }
  .publico h3 {
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
  }
  .publico p {
    max-width: 52ch;
  }

  /* Institucional */
  .inst__grade {
    display: grid;
    gap: 48px;
  }
  .inst__texto {
    display: grid;
    gap: 22px;
    align-content: start;
    justify-items: start;
  }
  .inst h2 {
    max-width: 18ch;
  }
  @media (min-width: 980px) {
    .inst__grade {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }
  .principios {
    margin: 0;
    display: grid;
  }
  .principios div {
    padding: 24px 0;
    border-top: 1px solid var(--line-l-2);
  }
  .principios div:last-child {
    border-bottom: 1px solid var(--line-l-2);
  }
  .principios dt {
    font-weight: 600;
    font-size: 1.08rem;
    margin-bottom: 6px;
  }
  .principios dd {
    margin: 0;
    color: var(--tx-l-2);
  }
</style>
