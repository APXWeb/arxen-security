---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Trilha from '../../components/Trilha.astro';
import LogoFabricante from '../../components/LogoFabricante.astro';
import CardSolucao from '../../components/CardSolucao.astro';
import ChamadaFinal from '../../components/ChamadaFinal.astro';
import { solucoes } from '../../data/solucoes';
import { fabricantePorSlug } from '../../data/fabricantes';
import { categoriaPorSlug } from '../../data/categorias';
import type { Solucao } from '../../data/tipos';
import { rotas, rotuloConversao } from '../../lib/utils';

export function getStaticPaths() {
  return solucoes.map((s) => ({ params: { slug: s.slug }, props: { solucao: s } }));
}

const { solucao: s } = Astro.props as { solucao: Solucao };
const fab = fabricantePorSlug(s.fabricante)!;
const cats = s.categorias.map((c) => categoriaPorSlug(c)!);
const principal = categoriaPorSlug(s.categoriaPrincipal)!;

const pontuar = (o: Solucao) =>
  (o.fabricante === s.fabricante ? 1 : 0) + o.categorias.filter((c) => s.categorias.includes(c)).length * 2;
const relacionadas = solucoes
  .filter((o) => o.slug !== s.slug)
  .map((o) => ({ o, p: pontuar(o) }))
  .filter((x) => x.p > 0)
  .sort((a, b) => b.p - a.p)
  .slice(0, 3)
  .map((x) => x.o);

const tipoPedido = {
  proposta: 'Proposta comercial',
  avaliacao: 'Avaliação do ambiente',
  demonstracao: 'Demonstração',
}[s.conversao];

const secoes = [
  { id: 'o-que-e', rotulo: 'O que é' },
  { id: 'problema', rotulo: 'Problema que resolve' },
  { id: 'cenarios', rotulo: 'Cenários indicados' },
  { id: 'como-funciona', rotulo: 'Como funciona' },
  { id: 'recursos', rotulo: 'Principais recursos' },
  { id: 'requisitos', rotulo: 'Requisitos e observações' },
  { id: 'como-solicitar', rotulo: 'Como solicitar' },
];

const urlContato = rotas.contato({ solucao: s.slug });
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: s.nome,
  description: s.descricao,
  brand: { '@type': 'Brand', name: fab.nome },
  category: principal.nome,
};
---

<Base titulo={`${s.nome} — ${principal.curto}`} descricao={`${s.descricao} ${s.beneficio}`} jsonLd={ld} secaoAtiva="solucoes">
  <section class="sol-topo s-escura">
    <div class="wrap">
      <Trilha itens={[{ rotulo: 'Soluções', href: rotas.solucoes() }, { rotulo: principal.curto, href: rotas.categoria(principal.slug) }, { rotulo: s.nome }]} escura />
      <div class="sol-topo__grade">
        <div class="sol-topo__texto">
          <p class="rotulo">{s.familia ?? fab.nome}</p>
          <h1>{s.nome}</h1>
          <p class="lead">{s.descricao}</p>
          <div class="acoes">
            <a class="btn btn--primario" href={urlContato}>{rotuloConversao[s.conversao]} <Icon nome="seta" /></a>
            <a class="btn btn--contorno" href="#como-funciona">Ver como funciona</a>
          </div>
        </div>
        <aside class="ficha" aria-label="Resumo da solução">
          <a class="ficha__placa" href={rotas.fabricante(fab.slug)} aria-label={`Página do fabricante ${fab.nome}`}>
            <LogoFabricante fabricante={fab} area={3000} larguraMax={170} carregamento="eager" />
          </a>
          <dl>
            <div>
              <dt>Fabricante</dt>
              <dd><a href={rotas.fabricante(fab.slug)}>{fab.nome}</a></dd>
            </div>
            <div>
              <dt>Necessidades</dt>
              <dd class="ficha__cats">{cats.map((c) => <a href={rotas.categoria(c.slug)}>{c.curto}</a>)}</dd>
            </div>
            <div>
              <dt>Principal benefício</dt>
              <dd>{s.beneficio}</dd>
            </div>
            <div>
              <dt>Próximo passo</dt>
              <dd>{tipoPedido}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <div class="wrap sol-corpo">
    <nav class="sumario" aria-label="Nesta página">
      <p class="sumario__titulo">Nesta página</p>
      <ol>
        {secoes.map((sec) => <li><a href={`#${sec.id}`}>{sec.rotulo}</a></li>)}
      </ol>
    </nav>

    <div class="sol-conteudo">
      <section id="o-que-e" class="bloco" aria-labelledby="t-o-que-e">
        <h2 id="t-o-que-e">O que é</h2>
        <div class="prosa">{s.oQueE.map((p) => <p>{p}</p>)}</div>
      </section>

      <section id="problema" class="bloco problema" aria-labelledby="t-problema">
        <h2 id="t-problema">Qual problema ajuda a resolver</h2>
        <p class="problema__texto">{s.problema}</p>
      </section>

      <section id="cenarios" class="bloco" aria-labelledby="t-cenarios">
        <h2 id="t-cenarios">Para quais cenários é indicada</h2>
        <ul class="lista-check cenarios">
          {s.cenarios.map((c) => <li><Icon nome="check" /><span>{c}</span></li>)}
        </ul>
      </section>

      <section id="como-funciona" class="bloco" aria-labelledby="t-como">
        <h2 id="t-como">Como funciona, em termos gerais</h2>
        <ol class="fluxo" style={`--n:${s.comoFunciona.length}`}>
          {
            s.comoFunciona.map((etapa, i) => (
              <li class="fluxo__etapa revelar" style={`--atraso:${i * 90}ms`}>
                <span class="fluxo__marca" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3>{etapa.titulo}</h3>
                <p class="texto-2">{etapa.texto}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="recursos" class="bloco" aria-labelledby="t-recursos">
        <h2 id="t-recursos">Principais recursos</h2>
        <dl class="recursos">
          {
            s.recursos.map((r) => (
              <div class="recurso">
                <dt>{r.titulo}</dt>
                <dd>{r.texto}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="requisitos" class="bloco" aria-labelledby="t-req">
        <h2 id="t-req">Requisitos e observações</h2>
        <div class="req">
          {
            s.requisitos.length > 0 && (
              <div class="req__col">
                <h3>Confirmado em fonte oficial</h3>
                <ul>{s.requisitos.map((r) => <li>{r}</li>)}</ul>
              </div>
            )
          }
          <div class="req__col req__col--confirmar">
            <h3>Definido na avaliação ou proposta</h3>
            <ul>{s.aConfirmar.map((r) => <li>{r}</li>)}</ul>
          </div>
        </div>
        <p class="req__nota texto-2">
          Compatibilidades, versões suportadas e composição de licenças são definidas pelo fabricante e podem mudar. Antes da proposta, a ARXEN verifica esses pontos para o seu ambiente.
        </p>
      </section>

      <section id="como-solicitar" class="bloco solicitar" aria-labelledby="t-sol">
        <h2 id="t-sol">Como solicitar</h2>
        <ol class="solicitar__passos">
          <li><span><strong>Envie o contexto.</strong> Informe o ambiente e o objetivo no formulário — a solução já vem selecionada.</span></li>
          <li><span><strong>Conversa de entendimento.</strong> A equipe confirma requisitos e verifica se esta é a opção mais adequada.</span></li>
          <li><span><strong>{tipoPedido}.</strong> Você recebe o próximo passo indicado para {s.nome}.</span></li>
        </ol>
        <div class="acoes">
          <a class="btn btn--primario" href={urlContato}>{rotuloConversao[s.conversao]} <Icon nome="seta" /></a>
          <a class="btn btn--contorno" href={rotas.contato({ solucao: s.slug, perfil: 'revenda' })}>Sou revenda</a>
        </div>
      </section>

      <section class="bloco fontes" aria-labelledby="t-fontes">
        <h2 id="t-fontes" class="fontes__titulo">Fontes consultadas</h2>
        <ul>
          {
            s.fontes.map((f) => (
              <li>
                <a href={f.url} rel="noopener" target="_blank">
                  {f.rotulo} <Icon nome="externo" tamanho={14} />
                  <span class="sr-only">(abre em nova aba)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  {
    relacionadas.length > 0 && (
      <section class="secao--compacta s-papel" aria-labelledby="t-rel">
        <div class="wrap">
          <div class="rel__cabeca">
            <h2 id="t-rel">Soluções relacionadas</h2>
            <a class="link-seta" href={rotas.categoria(principal.slug)}><span>Tudo em {principal.curto}</span><Icon nome="seta" /></a>
          </div>
          <div class="rel__grade">{relacionadas.map((r) => <CardSolucao solucao={r} />)}</div>
        </div>
      </section>
    )
  }

  <ChamadaFinal titulo={`Quer saber se ${s.nome} atende o seu ambiente?`} rotuloBotao={rotuloConversao[s.conversao]} hrefBotao={urlContato} secundario={{ rotulo: `Mais de ${fab.nome}`, href: rotas.fabricante(fab.slug) }} />
</Base>

<style>
  .sol-topo {
    padding-block: 28px clamp(48px, 7vw, 88px);
  }
  .sol-topo__grade {
    display: grid;
    gap: 40px;
    margin-top: clamp(28px, 5vw, 56px);
  }
  .sol-topo__texto {
    display: grid;
    gap: 20px;
    justify-items: start;
    align-content: start;
  }
  .sol-topo h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.6rem);
    max-width: 18ch;
  }
  @media (min-width: 1000px) {
    .sol-topo__grade {
      grid-template-columns: 1fr 380px;
      gap: 72px;
      align-items: end;
    }
  }
  .ficha {
    border: 1px solid var(--line-d-2);
    border-radius: var(--r-3);
    background: var(--ink-1);
    padding: 10px;
  }
  .ficha__placa {
    display: grid;
    place-items: center;
    height: 104px;
    border-radius: var(--r-2);
    background: var(--white);
  }
  .ficha dl {
    margin: 0;
    padding: 6px 12px 4px;
  }
  .ficha dl div {
    padding: 14px 0;
    border-bottom: 1px solid var(--line-d);
  }
  .ficha dl div:last-child {
    border-bottom: 0;
  }
  .ficha dt {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tx-d-3);
    margin-bottom: 4px;
  }
  .ficha dd {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.5;
  }
  .ficha a {
    color: var(--tx-d-1);
    text-underline-offset: 3px;
    text-decoration-color: var(--line-d-2);
  }
  .ficha a:hover {
    text-decoration-color: var(--blue);
  }
  .ficha__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .sol-corpo {
    display: grid;
    gap: 40px;
    padding-block: clamp(48px, 6vw, 88px);
  }
  .sumario {
    display: none;
  }
  @media (min-width: 1000px) {
    .sol-corpo {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 72px;
    }
    .sumario {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
  }
  .sumario__titulo {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tx-l-2);
    margin-bottom: 12px;
  }
  .sumario ol {
    list-style: none;
    border-left: 1px solid var(--line-l);
  }
  .sumario a {
    display: block;
    padding: 7px 0 7px 16px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.9rem;
    color: var(--tx-l-2);
    text-decoration: none;
    transition: color var(--t-1), border-color var(--t-1);
  }
  .sumario a:hover,
  .sumario a.ativo {
    color: var(--tx-l-1);
    border-left-color: var(--blue-ink);
  }

  .sol-conteudo {
    max-width: 820px;
  }
  .bloco {
    padding-block: 40px;
    border-top: 1px solid var(--line-l);
  }
  .bloco:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .bloco > h2 {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    margin-bottom: 22px;
  }
  .prosa p {
    font-size: 1.06rem;
    line-height: 1.7;
  }
  .problema {
    border-top: 0;
  }
  .problema__texto {
    padding: 26px 28px;
    background: var(--paper);
    border: 1px solid var(--line-l);
    border-radius: var(--r-2);
    font-size: 1.08rem;
    line-height: 1.65;
  }
  .cenarios li {
    font-size: 1.02rem;
  }

  .fluxo {
    list-style: none;
    display: grid;
    gap: 14px;
    counter-reset: etapa;
  }
  @media (min-width: 720px) {
    .fluxo {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: 0;
    }
  }
  .fluxo__etapa {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 22px;
    background: var(--ink-0);
    color: var(--tx-d-1);
    border-radius: var(--r-2);
  }
  @media (min-width: 720px) {
    .fluxo__etapa {
      border-radius: 0;
      border-right: 1px solid var(--line-d);
    }
    .fluxo__etapa:first-child {
      border-radius: var(--r-2) 0 0 var(--r-2);
    }
    .fluxo__etapa:last-child {
      border-radius: 0 var(--r-2) var(--r-2) 0;
      border-right: 0;
    }
    .fluxo__etapa:not(:last-child)::after {
      content: '';
      position: absolute;
      right: -7px;
      top: 30px;
      z-index: 1;
      width: 12px;
      height: 12px;
      background: var(--ink-0);
      border-top: 1px solid var(--line-d-2);
      border-right: 1px solid var(--line-d-2);
      transform: rotate(45deg);
    }
  }
  .fluxo__marca {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--blue);
    margin-bottom: 8px;
  }
  .fluxo__etapa h3 {
    font-size: 1.05rem;
  }
  .fluxo__etapa p {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--tx-d-2);
  }

  .recursos {
    margin: 0;
    display: grid;
    gap: 0;
  }
  @media (min-width: 680px) {
    .recursos {
      grid-template-columns: 1fr 1fr;
      column-gap: 40px;
    }
  }
  .recurso {
    padding: 18px 0;
    border-top: 1px solid var(--line-l);
  }
  .recurso dt {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .recurso dd {
    margin: 0;
    color: var(--tx-l-2);
    font-size: 0.95rem;
  }

  .req {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 680px) {
    .req {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
  }
  .req__col {
    padding: 22px 24px;
    border: 1px solid var(--line-l);
    border-radius: var(--r-2);
  }
  .req__col--confirmar {
    background: var(--paper);
  }
  .req__col h3 {
    font-size: 0.95rem;
    margin-bottom: 12px;
  }
  .req__col ul {
    padding-left: 1.1em;
    display: grid;
    gap: 8px;
    font-size: 0.94rem;
    color: var(--tx-l-2);
  }
  .req__nota {
    margin-top: 18px;
    font-size: 0.88rem;
  }

  .solicitar__passos {
    list-style: none;
    counter-reset: passo;
    display: grid;
    gap: 14px;
    margin-bottom: 28px;
  }
  .solicitar__passos li {
    counter-increment: passo;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    color: var(--tx-l-2);
  }
  .solicitar__passos li::before {
    content: counter(passo);
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--line-l-2);
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--tx-l-1);
  }
  .solicitar__passos strong {
    color: var(--tx-l-1);
  }
  .fontes {
    padding-bottom: 0;
  }
  .fontes__titulo {
    font-size: 1rem !important;
    margin-bottom: 10px !important;
  }
  .fontes ul {
    list-style: none;
    display: grid;
    gap: 4px;
  }
  .fontes a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    font-size: 0.9rem;
    color: var(--tx-l-2);
    text-underline-offset: 3px;
  }
  .fontes a:hover {
    color: var(--blue-ink);
  }

  .rel__cabeca {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 12px;
    margin-bottom: 28px;
  }
  .rel__cabeca h2 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }
  .rel__grade {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 700px) {
    .rel__grade {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
  }
</style>

<script>
  // Destaca no sumário a seção em leitura.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.sumario a')];
  if (links.length && 'IntersectionObserver' in window) {
    const porId = new Map(links.map((a) => [a.hash.slice(1), a]));
    const obs = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.classList.remove('ativo'));
          porId.get(e.target.id)?.classList.add('ativo');
        });
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    porId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) obs.observe(el);
    });
  }
</script>
