---
import Icon from './Icon.astro';
import type { BlocoFabricante } from '../data/tipos';

interface Props {
  bloco: BlocoFabricante;
  id: string;
}
const { bloco: b, id } = Astro.props;
---

<section class:list={['bf', `bf--${b.tipo}`]} aria-labelledby={id}>
  <div class="bf__cabeca">
    <h2 id={id}>{b.titulo}</h2>
    {b.intro && <p class="lead">{b.intro}</p>}
  </div>

  {
    b.tipo === 'tabela' && (
      <div class="bf__tabela-rolagem" tabindex="0" role="region" aria-label={b.titulo}>
        <table class="bf__tabela">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Recurso</span></th>
              {b.colunas.map((c) => <th scope="col">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {b.linhas.map((l) => (
              <tr>
                <th scope="row">{l.rotulo}</th>
                {l.valores.map((v) => (
                  <td>
                    {v === true ? (
                      <>
                        <Icon nome="check" tamanho={18} class="bf__sim" />
                        <span class="sr-only">Incluído</span>
                      </>
                    ) : v === false ? (
                      <>
                        <span class="bf__nao" aria-hidden="true">—</span>
                        <span class="sr-only">Não incluído</span>
                      </>
                    ) : (
                      <span class="bf__valor">{v}</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    b.tipo === 'etapas' && (
      <ol class="bf__etapas" style={`--n:${b.etapas.length}`}>
        {b.etapas.map((e, i) => (
          <li class="revelar" style={`--atraso:${i * 80}ms`}>
            <span class="bf__ponto" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{e.titulo}</h3>
            <p class="texto-2">{e.texto}</p>
          </li>
        ))}
      </ol>
    )
  }

  {
    b.tipo === 'blocos' && (
      <ul class="bf__blocos">
        {b.itens.map((it, i) => (
          <li class="revelar" style={`--atraso:${(i % 3) * 70}ms`}>
            <h3>{it.titulo}</h3>
            <p class="texto-2">{it.texto}</p>
          </li>
        ))}
      </ul>
    )
  }

  {
    b.tipo === 'perfis' && (
      <div class="bf__perfis">
        {b.perfis.map((p, i) => (
          <article class:list={['bf__perfil revelar', { 's-escura': i === 1 }]} style={`--atraso:${i * 90}ms`}>
            <h3>{p.titulo}</h3>
            <p class="texto-2">{p.texto}</p>
            <ul class="lista-check">
              {p.itens.map((it) => (
                <li>
                  <Icon nome="check" />
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    )
  }

  {b.nota && <p class="bf__nota"><Icon nome="info" tamanho={16} /><span>{b.nota}</span></p>}
</section>

<style>
  .bf {
    display: grid;
    gap: 32px;
  }
  /* Itens de grid não podem crescer além da coluna (a tabela rola por dentro). */
  .bf > * {
    min-width: 0;
  }
  .bf__cabeca {
    display: grid;
    gap: 14px;
    max-width: 760px;
  }
  .bf__cabeca h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.15rem);
  }
  .bf__nota {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 10px;
    font-size: 0.86rem;
    color: var(--tx-l-2);
    max-width: 820px;
  }
  .bf__nota :global(.icone) {
    margin-top: 3px;
  }

  /* tabela */
  .bf__tabela-rolagem {
    position: relative; /* contém os textos sr-only das células */
    overflow-x: auto;
    border: 1px solid var(--line-l);
    border-radius: var(--r-2);
    background: var(--white);
  }
  .bf__tabela {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.93rem;
  }
  .bf__tabela th,
  .bf__tabela td {
    padding: 15px 18px;
    border-bottom: 1px solid var(--line-l);
    text-align: center;
  }
  .bf__tabela tbody tr:last-child > * {
    border-bottom: 0;
  }
  .bf__tabela thead th {
    background: var(--ink-0);
    color: var(--tx-d-1);
    font-weight: 600;
    font-size: 0.88rem;
    white-space: nowrap;
  }
  .bf__tabela tbody th {
    text-align: left;
    font-weight: 500;
  }
  .bf__tabela tbody tr:hover {
    background: var(--paper);
  }
  .bf__tabela :global(.bf__sim) {
    margin-inline: auto;
    color: var(--blue-ink);
  }
  .bf__nao {
    color: var(--line-l-2);
  }
  .bf__valor {
    font-weight: 500;
    white-space: nowrap;
  }

  /* etapas */
  .bf__etapas {
    list-style: none;
    display: grid;
    gap: 0;
    position: relative;
  }
  .bf__etapas li {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 0 0 28px 48px;
  }
  .bf__etapas li::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 32px;
    bottom: 0;
    width: 1px;
    background: var(--line-l-2);
  }
  .bf__etapas li:last-child::before {
    display: none;
  }
  .bf__ponto {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    font-size: 0.84rem;
  }
  .bf__etapas h3 {
    font-size: 1.08rem;
    padding-top: 4px;
  }
  .bf__etapas p {
    font-size: 0.94rem;
    max-width: 44ch;
  }
  @media (min-width: 900px) {
    .bf__etapas {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: 24px;
    }
    .bf__etapas li {
      padding: 52px 0 0;
    }
    .bf__etapas li::before {
      left: 40px;
      right: -24px;
      top: 15px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }

  /* blocos */
  .bf__blocos {
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--line-l);
    border: 1px solid var(--line-l);
    border-radius: var(--r-2);
    overflow: hidden;
  }
  @media (min-width: 700px) {
    .bf__blocos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .bf__blocos:has(> li:nth-child(5)) {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .bf__blocos li {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 26px;
    background: var(--white);
  }
  .bf__blocos h3 {
    font-size: 1.05rem;
  }
  .bf__blocos p {
    font-size: 0.94rem;
  }

  /* perfis */
  .bf__perfis {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 800px) {
    .bf__perfis {
      grid-template-columns: 1fr 1fr;
    }
  }
  .bf__perfil {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--r-3);
    background: var(--paper);
    border: 1px solid var(--line-l);
  }
  .bf__perfil.s-escura {
    background: var(--ink-0);
    border-color: var(--ink-0);
  }
  .bf__perfil h3 {
    font-size: 1.25rem;
  }
  .bf__perfil .lista-check {
    margin-top: 8px;
  }
</style>
