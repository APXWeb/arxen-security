---
// Esquema de camadas concêntricas: cada anel representa uma superfície a
// proteger. Movimento lento e contínuo; parado com movimento reduzido.
const aneis = [
  { r: 228, rotulo: 'Nuvem e e-mail' },
  { r: 178, rotulo: 'Rede e identidades' },
  { r: 128, rotulo: 'Dispositivos' },
  { r: 78, rotulo: 'Dados' },
];
---

<div class="camadas" aria-hidden="true">
  <svg viewBox="0 0 520 520" role="presentation">
    <defs>
      <radialGradient id="nucleo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#3d7bff" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#3d7bff" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="grade-fade" cx="50%" cy="50%" r="50%">
        <stop offset="55%" stop-color="#fff" />
        <stop offset="100%" stop-color="#000" />
      </radialGradient>
      <mask id="grade-mask"><rect width="520" height="520" fill="url(#grade-fade)" /></mask>
    </defs>

    <!-- grade de fundo -->
    <g class="camadas__grade" mask="url(#grade-mask)">
      {Array.from({ length: 13 }, (_, i) => <line x1={i * 40 + 20} y1="0" x2={i * 40 + 20} y2="520" />)}
      {Array.from({ length: 13 }, (_, i) => <line x1="0" y1={i * 40 + 20} x2="520" y2={i * 40 + 20} />)}
    </g>

    <circle cx="260" cy="260" r="120" fill="url(#nucleo)" />

    {
      aneis.map((a, i) => (
        <g class="camadas__anel" style={`--i:${i}`}>
          <circle cx="260" cy="260" r={a.r} class={i % 2 ? 'tracejado' : ''} />
          <g class="camadas__orbita" style={`--dur:${42 + i * 14}s; --dir:${i % 2 ? -1 : 1}`}>
            <circle cx={260 + a.r} cy="260" r="3.5" class="no" />
            <circle cx={260 - a.r} cy="260" r="2.5" class="no no--fraco" />
          </g>
        </g>
      ))
    }

    <!-- varredura -->
    <g class="camadas__varredura">
      <path d="M260 260 L260 32 A228 228 0 0 1 421.2 98.8 Z" />
    </g>

    <!-- núcleo -->
    <g class="camadas__nucleo">
      <rect x="236" y="236" width="48" height="48" rx="6" />
      <path d="M252 262 l6 6 12-14" />
    </g>

    {
      aneis.map((a) => {
        // Rótulo centrado no topo de cada anel, sobre uma tarja que interrompe a linha.
        const y = 260 - a.r;
        const largura = a.rotulo.length * 8.1 + 22;
        return (
          <g class="camadas__rotulo">
            <rect x={260 - largura / 2} y={y - 11} width={largura} height="22" rx="11" />
            <text x="260" y={y + 4.2} text-anchor="middle">
              {a.rotulo}
            </text>
          </g>
        );
      })
    }
  </svg>
</div>

<style>
  .camadas {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .camadas svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .camadas__grade line {
    stroke: rgba(255, 255, 255, 0.045);
    stroke-width: 1;
  }
  .camadas__anel > circle {
    fill: none;
    stroke: rgba(154, 165, 183, 0.3);
    stroke-width: 1;
  }
  .camadas__anel > circle.tracejado {
    stroke-dasharray: 2 6;
    stroke: rgba(154, 165, 183, 0.42);
  }
  .camadas__anel:nth-child(odd) > circle {
    stroke: rgba(61, 123, 255, 0.4);
  }
  .camadas__orbita {
    transform-origin: 260px 260px;
    animation: orbita var(--dur) linear infinite;
    animation-direction: normal;
  }
  .camadas__anel:nth-of-type(even) .camadas__orbita {
    animation-direction: reverse;
  }
  .no {
    fill: #3d7bff;
  }
  .no--fraco {
    fill: #9aa5b7;
    opacity: 0.6;
  }
  @keyframes orbita {
    to {
      transform: rotate(360deg);
    }
  }
  .camadas__varredura {
    transform-origin: 260px 260px;
    animation: orbita 14s linear infinite;
  }
  .camadas__varredura path {
    fill: url(#nucleo);
    opacity: 0.22;
  }
  .camadas__nucleo rect {
    fill: #04275d;
    stroke: #3d7bff;
    stroke-width: 1.2;
  }
  .camadas__nucleo path {
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .camadas__rotulo rect {
    fill: #05070b;
    stroke: rgba(154, 165, 183, 0.35);
    stroke-width: 1;
  }
  .camadas__rotulo text {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    fill: #c9d1de;
    text-transform: uppercase;
  }
  .camadas__rotulo:last-of-type text {
    fill: #fff;
  }
  .camadas__anel {
    opacity: 0;
    animation: anel-entra 900ms var(--ease) forwards;
    animation-delay: calc(var(--i) * 120ms + 150ms);
  }
  @keyframes anel-entra {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .camadas__anel {
    transform-origin: 260px 260px;
  }
  @media (prefers-reduced-motion: reduce) {
    .camadas__orbita,
    .camadas__varredura {
      animation: none;
    }
    .camadas__anel {
      opacity: 1;
      animation: none;
    }
  }
</style>
