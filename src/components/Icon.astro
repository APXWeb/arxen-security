---
import type { IconeNome } from '../data/tipos';

interface Props {
  nome: IconeNome;
  tamanho?: number;
  class?: string;
  rotulo?: string;
}

const { nome, tamanho = 24, class: classe, rotulo } = Astro.props;

// Ícones de traço único, grade 24px, traço 1.6 — desenhados para o site.
const caminhos: Record<IconeNome, string> = {
  endpoint: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4"/><path d="M12 7.2l3 1.2v2.1c0 1.8-1.3 3-3 3.6-1.7-.6-3-1.8-3-3.6V8.4z"/>',
  dados: '<ellipse cx="12" cy="6" rx="7" ry="2.6"/><path d="M5 6v6c0 1.4 3.1 2.6 7 2.6"/><path d="M19 6v4"/><path d="M5 12v6c0 1.4 3.1 2.6 7 2.6"/><rect x="14.5" y="14" width="6" height="5.5" rx="1"/><path d="M15.8 14v-1.4a1.7 1.7 0 013.4 0V14"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3.5 6l8.5 6.5L20.5 6"/><path d="M15 19l2-2 3 3"/>',
  backup: '<path d="M4 12a8 8 0 0113.7-5.6L20 8.7"/><path d="M20 4v4.7h-4.7"/><path d="M20 12a8 8 0 01-13.7 5.6L4 15.3"/><path d="M4 20v-4.7h4.7"/><circle cx="12" cy="12" r="2"/>',
  acesso: '<circle cx="8.5" cy="12" r="3.5"/><path d="M12 12h9M18 12v3M15.5 12v2"/><circle cx="8.5" cy="12" r="1" />',
  vulnerabilidade: '<path d="M12 3l8 3.5v5.2c0 4.4-3.4 8-8 9.3-4.6-1.3-8-4.9-8-9.3V6.5z"/><path d="M12 8v5M12 16.2v.3"/>',
  deteccao: '<circle cx="11" cy="11" r="7"/><path d="M20.5 20.5L16 16"/><path d="M7.5 11h1.8l1.2-2.5 1.8 5 1.2-2.5h1.5"/>',
  corporativo: '<path d="M4 21V7l8-4 8 4v14"/><path d="M9 21v-5h6v5"/><path d="M8 9.5h.01M12 9.5h.01M16 9.5h.01M8 13h.01M12 13h.01M16 13h.01"/>',
  empresa: '<rect x="4" y="3" width="10" height="18" rx="1"/><path d="M14 9h5a1 1 0 011 1v11H14"/><path d="M7.5 7h3M7.5 11h3M7.5 15h3"/>',
  revenda: '<circle cx="7" cy="8" r="3"/><circle cx="17" cy="8" r="3"/><path d="M2.5 20c.6-3.2 2.4-5 4.5-5s3.9 1.8 4.5 5"/><path d="M12.5 20c.6-3.2 2.4-5 4.5-5s3.9 1.8 4.5 5"/>',
  seta: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  busca: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>',
  filtro: '<path d="M4 6h16M7 12h10M10 18h4"/>',
  fechar: '<path d="M6 6l12 12M18 6L6 18"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h10"/>',
  externo: '<path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"/>',
  info: '<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5M12 8v.2"/>',
};
---

<svg
  class:list={['icone', classe]}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={rotulo ? undefined : 'true'}
  role={rotulo ? 'img' : undefined}
  aria-label={rotulo}
  focusable="false"
  set:html={caminhos[nome]}
/>
