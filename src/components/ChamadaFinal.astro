---
import Icon from './Icon.astro';
import { rotas } from '../lib/utils';

interface Props {
  titulo?: string;
  texto?: string;
  rotuloBotao?: string;
  hrefBotao?: string;
  secundario?: { rotulo: string; href: string };
}

const {
  titulo = 'Fale com a equipe da ARXEN.',
  texto = 'Conte como é o seu ambiente hoje e o que precisa resolver. A equipe responde com as soluções indicadas e o próximo passo: avaliação, demonstração ou proposta.',
  rotuloBotao = 'Falar com especialista',
  hrefBotao = rotas.contato(),
  secundario = { rotulo: 'Explorar o catálogo', href: rotas.solucoes() },
} = Astro.props;
---

<section class="chamada s-escura" aria-labelledby="chamada-titulo">
  <div class="wrap chamada__grade">
    <div class="revelar">
      <h2 id="chamada-titulo">{titulo}</h2>
    </div>
    <div class="chamada__lado revelar" style="--atraso:120ms">
      <p class="lead">{texto}</p>
      <div class="acoes">
        <a class="btn btn--primario" href={hrefBotao}>{rotuloBotao} <Icon nome="seta" /></a>
        {secundario && <a class="btn btn--contorno" href={secundario.href}>{secundario.rotulo}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .chamada {
    position: relative;
    overflow: hidden;
    padding-block: clamp(80px, 10vw, 128px);
    border-top: 1px solid var(--line-d);
  }
  .chamada__grade {
    position: relative;
    display: grid;
    gap: 32px;
  }
  .chamada h2 {
    max-width: 18ch;
  }
  .chamada__lado {
    display: grid;
    gap: 28px;
    align-content: end;
  }
  @media (min-width: 960px) {
    .chamada__grade {
      grid-template-columns: 1.2fr 1fr;
      gap: 72px;
      align-items: end;
    }
  }
</style>
